{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact.local/schema/run-receipt.schema.json",
  "title": "PACT Command Run Receipt",
  "type": "object",
  "required": [
    "version",
    "task_id",
    "argv",
    "cwd",
    "started_at",
    "finished_at",
    "exit_code",
    "status",
    "stdout_sha256",
    "stderr_sha256",
    "git_head",
    "git_dirty"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "cwd": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "minLength": 1 },
    "finished_at": { "type": "string", "minLength": 1 },
    "exit_code": { "type": "integer" },
    "status": { "enum": ["pass", "fail"] },
    "stdout_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stderr_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "git_head": { "type": ["string", "null"] },
    "git_dirty": { "type": ["boolean", "null"] }
  }
}
