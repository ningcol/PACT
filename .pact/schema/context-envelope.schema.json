{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact.local/schema/context-envelope.schema.json",
  "title": "PACT Task Context Envelope",
  "type": "object",
  "required": [
    "version",
    "status",
    "task",
    "goal",
    "observable_success",
    "risk_level",
    "discovery_query",
    "domains",
    "artifacts",
    "applicable_rules",
    "decisions",
    "verification_targets",
    "known_unknowns",
    "risk_policy",
    "context_budget"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "status": {
      "enum": [
        "candidate",
        "sufficient"
      ]
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "observable_success": {
      "type": "string",
      "minLength": 1
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "discovery_query": {
      "type": "string",
      "minLength": 1
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "artifact_type",
          "title",
          "score",
          "reasons",
          "estimated_tokens"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifact_type": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "integer",
            "minimum": 0
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "estimated_tokens": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "applicable_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "verification_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "known_unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "code_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "language",
          "is_test",
          "symbols",
          "score",
          "reasons",
          "relation",
          "confidence",
          "estimated_tokens"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "is_test": {
            "type": "boolean"
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "score": {
            "type": "integer",
            "minimum": 0
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "direct",
              "relative-resolved",
              "ast-resolved",
              "heuristic"
            ]
          },
          "estimated_tokens": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "risk_policy": {
      "type": "object",
      "required": [
        "knowledge_limit",
        "code_context",
        "code_limit",
        "completion",
        "materialization_token_budget"
      ],
      "additionalProperties": false,
      "properties": {
        "knowledge_limit": {
          "type": "integer",
          "minimum": 1
        },
        "code_context": {
          "type": "boolean"
        },
        "code_limit": {
          "type": "integer",
          "minimum": 1
        },
        "completion": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "materialization_token_budget": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "discovery_queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "context_budget": {
      "type": "object",
      "required": [
        "limit_tokens",
        "selected_estimated_tokens",
        "candidate_estimated_tokens",
        "knowledge_selected",
        "code_selected",
        "dropped_candidates",
        "dropped_for_token_budget",
        "dropped_for_count_limit",
        "authority_candidates_dropped",
        "truncated",
        "authority_overage_tokens",
        "selection_strategy",
        "token_estimation"
      ],
      "additionalProperties": false,
      "properties": {
        "limit_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "selected_estimated_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_estimated_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "knowledge_selected": {
          "type": "integer",
          "minimum": 0
        },
        "code_selected": {
          "type": "integer",
          "minimum": 0
        },
        "dropped_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "dropped_for_token_budget": {
          "type": "integer",
          "minimum": 0
        },
        "dropped_for_count_limit": {
          "type": "integer",
          "minimum": 0
        },
        "authority_candidates_dropped": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "authority_overage_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "selection_strategy": {
          "const": "authority-aware-soft-token-budget-v1"
        },
        "token_estimation": {
          "const": "utf8-bytes-div-4"
        }
      }
    }
  }
}
