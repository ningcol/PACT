{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact.local/schema/impact-report.schema.json",
  "title": "PACT Impact Report",
  "type": "object",
  "required": [
    "version",
    "changed_files",
    "impacted_domains",
    "deterministic_impacts",
    "candidate_impacts",
    "unmapped_files"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "changed_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "impacted_domains": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "deterministic_impacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/impact" }
    },
    "candidate_impacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "unmapped_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "required": ["path", "artifact_type", "title"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "id": { "type": ["string", "null"] },
        "artifact_type": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "impact": {
      "type": "object",
      "required": ["source_file", "relation", "target"],
      "additionalProperties": false,
      "properties": {
        "source_file": { "type": "string", "minLength": 1 },
        "relation": {
          "enum": [
            "artifact-changed",
            "declared-domain-path",
            "explicit-stable-id",
            "explicit-doc-link",
            "verification-reference"
          ]
        },
        "target": { "$ref": "#/$defs/target" }
      }
    },
    "candidate": {
      "type": "object",
      "required": ["score", "reasons", "target"],
      "additionalProperties": false,
      "properties": {
        "score": { "type": "integer", "minimum": 1 },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "target": { "$ref": "#/$defs/target" }
      }
    }
  }
}
